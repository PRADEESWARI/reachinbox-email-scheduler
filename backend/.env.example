# Server
PORT=4000
JWT_SECRET=supersecretchangethis

# Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# BullMQ worker
WORKER_CONCURRENCY=5
MIN_DELAY_MS_BETWEEN_SENDS=2000

# Rate limiting
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Ethereal (fake SMTP) - leave blank to auto-generate test account at boot
ETHEREAL_USER=
ETHEREAL_PASS=

# Google OAuth (real - see README for setup steps)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Slack OAuth (real "Add to Slack" flow - see README for setup steps)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/oauth/callback
